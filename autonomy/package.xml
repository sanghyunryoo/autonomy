<?xml version="1.0"?>
<package format="3">
  <name>autonomy</name>
  <version>0.1.0</version>
  <description>Autonomy manager core with a ROS 2/Cyclone DDS I/O boundary.</description>
  <maintainer email="sh.ryoo@cocelo.ai">autonomy maintainer</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>core</depend>
  <depend>cyclonedds</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>yaml-cpp</depend>

  <!-- Super-LIO core: ESKF, PCL voxel map, GTSAM pose graph, and TBB. -->
  <build_depend>libeigen3-dev</build_depend>
  <build_depend>libgoogle-glog-dev</build_depend>
  <build_depend>libpcl-dev</build_depend>
  <build_depend>libtbb-dev</build_depend>
  <depend>gtsam</depend>
  <exec_depend>libeigen3-dev</exec_depend>
  <exec_depend>libgoogle-glog-dev</exec_depend>
  <exec_depend>libpcl-dev</exec_depend>
  <exec_depend>libtbb-dev</exec_depend>

  <!-- Used only by the ROS-free URDF transform parser. -->
  <build_depend>libtinyxml2-dev</build_depend>
  <exec_depend>libtinyxml2-dev</exec_depend>

  <!-- Direct non-ROS sensor SDKs. Install librealsense2-dev and Livox SDK2. -->
  <build_depend>librealsense2-dev</build_depend>
  <exec_depend>librealsense2-dev</exec_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
